<Window x:Class="TimeAnchor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="TimeAnchor" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <!-- Ekranı altlı üstlü 2 satıra bölüyoruz -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST KISIM (Header Bar) -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0" materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <TextBlock Text="TimeAnchor" VerticalAlignment="Center" FontSize="22" FontWeight="Bold"/>

                <!-- Sağdaki + Butonu -->
                <Button x:Name="BtnAddReminder" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" ToolTip="Yeni Hatırlatıcı Ekle">
                    <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                </Button>
            </Grid>
        </materialDesign:ColorZone>

        <!-- ALT KISIM (Görevler Listesi) -->
        <ListBox x:Name="LstReminders" SelectionChanged="LstReminders_SelectionChanged" Grid.Row="1" Margin="10" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Her bir görev için Kart Görünümü (Card View) tasarımı -->
                    <materialDesign:Card Margin="5" Padding="15" materialDesign:ElevationAssist.Elevation="Dp2" Width="330">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Sol taraf (Metinler) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Sağ taraf (Butonlar) -->
                            </Grid.ColumnDefinitions>

                            <!-- Sol Taraf: Başlık ve Tarih -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding EventDate, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Sağ Taraf: Hızlı Aksiyon Butonları -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tamamlandı İkonu (Yeşil) -->
                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Tamamlandı İşaretle" Click="BtnComplete_Click">
                                    <materialDesign:PackIcon Kind="Check" Foreground="LimeGreen"/>
                                </Button>

                                <!-- Sil İkonu (Kırmızı) -->
                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Görevi Sil" Click="BtnQuickDelete_Click">
                                    <materialDesign:PackIcon Kind="Close" Foreground="Red"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>