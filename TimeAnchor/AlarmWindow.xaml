<Window x:Class="TimeAnchor.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Alarm" Height="250" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <materialDesign:Card Margin="10" UniformCornerRadius="15" materialDesign:ElevationAssist.Elevation="Dp8" Background="{DynamicResource MaterialDesignPaper}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="BellRing" Width="30" Height="30" Foreground="Orange" VerticalAlignment="Center"/>
                <TextBlock Text="VAKİT GELDİ!" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Orange"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15">
                <TextBlock x:Name="TxtTaskTitle" Text="Görev Başlığı Buraya Gelecek" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="Bu görevi şu an tamamladınız mı?" FontSize="14" Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="BtnComplete" Content="✔ TAMAMLA" Background="LimeGreen" BorderThickness="0" Click="BtnComplete_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSnooze" Content="⏳ 15 DK ERTELE" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Orange" BorderBrush="Orange" Click="BtnSnooze_Click" Margin="0,0,15,0"/>
                <Button x:Name="BtnIgnore" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Şimdilik Yoksay" Click="BtnIgnore_Click">
                    <materialDesign:PackIcon Kind="Close" Foreground="Red"/>
                </Button>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>